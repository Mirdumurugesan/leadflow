# SQLite works out of the box; for Postgres:
# DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
DATABASE_URL=sqlite:///./leadflow.db
# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Timezone used by the seed script to decide what "today" is
SEED_TZ=Asia/Kolkata
