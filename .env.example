# Used by docker-compose.yml. Copy to .env to override; every value has a default.

# Postgres
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Backend
CORS_ORIGINS=http://localhost:3000
SEED_ON_START=true
SEED_TZ=Asia/Kolkata

# Frontend (baked in at build time; the browser calls this URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
